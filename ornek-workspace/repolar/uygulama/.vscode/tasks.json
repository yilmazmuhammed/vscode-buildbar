{
  // Ic ice proje: VS Code bu dosyayi tanimaz (workspace klasoru degil), gorevleri
  // BuildBar kurar. dependsOn'u da BuildBar uygular: "derle" once "yapilandir"i
  // kosar, o basarisizsa derlemez.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "yapilandir",
      "detail": "build/.config uret",
      "type": "shell",
      "command": "make",
      "args": ["yapilandir"],
      "problemMatcher": []
    },
    {
      "label": "derle",
      "detail": "make derle (once yapilandir)",
      "type": "shell",
      "command": "make",
      "args": ["derle"],
      "dependsOn": "yapilandir",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "temizle",
      "detail": "build/ dizinini sil",
      "type": "shell",
      "command": "make",
      "args": ["temizle"],
      "problemMatcher": []
    }
  ]
}
